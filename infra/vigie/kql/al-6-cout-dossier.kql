// AL-6 : coût moyen par dossier en USD (jetons x prix par million). Source : audit.agent et audit.evaluation (AppTraces).
let prix = datatable(modele:string, entree:real, sortie:real)[$PRIX_KQL];
let dossiers = toscalar(
    AppTraces
    | where _ResourceId =~ "$APPI_ID"
    | where Message == "audit.evaluation"
    | count);
AppTraces
| where _ResourceId =~ "$APPI_ID"
| where Message == "audit.agent"
| extend modele = tostring(Properties.modele), tin = toint(Properties.tokens_entree), tout = toint(Properties.tokens_sortie)
| join kind=inner prix on modele
| summarize cout = sum((tin * entree + tout * sortie) / 1000000)
| project valeur = iff(dossiers == 0, real(null), cout / dossiers)
