# Copier en .env (jamais versionné) puis remplir. Clés SANS valeurs ici.
# Chaque clé est reportée À LA MAIN dans GitHub : voir docs/secrets.md (type, portée, usage YAML).

# --- Application ---------------------------------------------------------------
# local | staging | production (posé par la chaîne en Azure ; pas dans GitHub)
APP_ENV=

# --- Azure OpenAI / Foundry : sans endpoint, l'agent répond en mode dégradé ----------
# https://<ressource>.openai.azure.com (ex. svespuce-971) → variable GitHub du REPO
AZURE_OPENAI_ENDPOINT=
# 🔒 LOCAL SEULEMENT, jamais dans GitHub : vide = authentification Entra ID (az login).
#    En CI et dans Container Apps, aucune clé : OIDC et identité managée.
AZURE_OPENAI_API_KEY=
# surcharge locale du modèle ; la version de référence est épinglée dans llm.env (versionné)
AZURE_OPENAI_DEPLOYMENT=
# délai max d'un appel LLM en secondes (défaut 30, aligné sur la porte p95 ; pas dans GitHub)
LLM_DELAI_S=

# --- Azure : lu par make infra, puis reporté en variables GitHub ---------------------
AZURE_SUBSCRIPTION_ID=
# ex. francecentral (make infra seulement)
AZURE_LOCATION=
AZURE_RESOURCE_GROUP=
# nom globalement unique, minuscules et chiffres
ACR_NAME=
# (make infra seulement)
CONTAINERAPPS_ENV=
# → variable CONTAINER_APP_NAME de l'environnement GitHub « staging »
APP_STAGING=
# → variable CONTAINER_APP_NAME de l'environnement GitHub « production »
APP_PRODUCTION=
# affichés par make infra (identité OIDC de la CI : identifiants, pas des secrets)
AZURE_CLIENT_ID=
AZURE_TENANT_ID=

# --- Entra ID : inscriptions d'application des services (S3-20) → variables GitHub du REPO ---
# ID client de agentinsurflow-rag (audience des jetons ; client public de la page Swagger)
RAG_API_CLIENT_ID=
# ID client de agentinsurflow-underwriting
UNDERWRITING_API_CLIENT_ID=

# --- PostgreSQL annexe (make up, make test-integration) -------------------------------
# 🔒 mots de passe générés (ex. openssl rand -hex 16) ; en Azure : secrets de la Container App,
#    en CI : générés à chaque run. Jamais dans GitHub.
PG_POSTGRES_PASSWORD=
PG_MIGRATEUR_PASSWORD=
PG_WRITER_PASSWORD=
PG_READER_PASSWORD=
PG_DOSSIERS_PASSWORD=
PG_TRACES_WRITER_PASSWORD=
PG_TRACES_READER_PASSWORD=
# localhost par défaut ; « postgres » dans le compose
PG_HOST=
# 5432 par défaut (port publié par le compose)
PG_PORT=

# --- GitHub (Makefile : proteger, rollback, preuve) -----------------------------------
# acerolaz/agentinsurflow
GITHUB_REPO=
