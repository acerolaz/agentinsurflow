  "components": {
    "schemas": {
      "BrouillonCorps": {
        "required": [
          "fiche",
          "prime"
        ],
        "type": "object",
        "properties": {
          "fiche": {
            "$ref": "#/components/schemas/FicheBrouillon"
          },
          "prime": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PrimeBrouillon"
              }
            ]
          }
        }
      },
      "EtatCorps": {
        "required": [
          "statut_parcours",
          "tentative",
          "sections",
          "rapports",
          "tours"
        ],
        "type": "object",
        "properties": {
          "statut_parcours": {
            "type": [
              "null",
              "string"
            ]
          },
          "tentative": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "sections": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/SectionCorps"
            }
          },
          "rapports": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/RapportCorps"
            }
          },
          "tours": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/TourCorps"
            }
          }
        }
      },
      "EtatReponse": {
        "required": [
          "statut_parcours",
          "tentative",
          "nb_relances",
          "rapports",
          "sections"
        ],
        "type": "object",
        "properties": {
          "statut_parcours": {
            "type": [
              "null",
              "string"
            ]
          },
          "tentative": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "nb_relances": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "rapports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RapportLu"
            }
          },
          "sections": {
            "type": "object"
          }
        }
      },
      "FicheBrouillon": {
        "required": [
          "decision",
          "contrat_type",
          "score",
          "version_bareme",
          "regle_ids",
          "motifs",
          "citations"
        ],
        "type": "object",
        "properties": {
          "decision": {
            "type": "string"
          },
          "contrat_type": {
            "type": "string"
          },
          "score": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "version_bareme": {
            "type": "string"
          },
          "regle_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "motifs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "JsonElement": { },
      "ObservationsCorps": {
        "required": [
          "observations"
        ],
        "type": "object",
        "properties": {
          "observations": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PieceDeclaree": {
        "required": [
          "type",
          "date_emission"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "date_emission": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "PrimeBrouillon": {
        "required": [
          "prime_ttc",
          "periodicite",
          "date_effet"
        ],
        "type": "object",
        "properties": {
          "prime_ttc": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "periodicite": {
            "type": "string"
          },
          "date_effet": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
