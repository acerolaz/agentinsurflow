# Seuils des garde-fous LLM Guard (A2) — calibrés en tâche 13 (make garde-fous). Les variables d'environnement priment.
# Signal seulement (score journalisé, jamais bloquant) : l'injection est bloquée par les règles déterministes
# de domain/injection.py ; le modèle est saturé (0 ou 1) et ne sépare pas le français.
SEUIL_INJECTION=0.98
SEUIL_SUJETS=0.88
SUJETS_HORS_PERIMETRE=politique,religion,santé,recette de cuisine,programmation,divertissement,finance personnelle hors assurance
# Plafond de faux positifs MESURÉ (0 % sur 34 lignes légitimes, arrondi aux 5 % supérieurs), pas une cible.
PLAFOND_FAUX_POSITIFS=0.00
