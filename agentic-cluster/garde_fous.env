# Seuils des garde-fous LLM Guard (A2) — calibrés en tâche 13 (make garde-fous). Les variables d'environnement priment.
SEUIL_INJECTION=0.98
SEUIL_SUJETS=0.88
SUJETS_HORS_PERIMETRE=politique,religion,santé,recette de cuisine,programmation,divertissement,finance personnelle hors assurance
# Plafond de faux positifs MESURÉ (41,2 % arrondi aux 5 % supérieurs), pas une cible : le modèle d'injection
# est saturé (score 0 ou 1) et juge ~40 % du français légitime comme injection ; aucun seuil ne le sépare.
# Un faux positif coûte une revue humaine, pas une faille. À rebaisser si le modèle change.
PLAFOND_FAUX_POSITIFS=0.45
