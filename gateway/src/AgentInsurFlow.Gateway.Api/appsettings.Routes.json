{
  "ReverseProxy": {
    "Routes": {
      "rag-reponses": {
        "AuthorizationPolicy": "rag-gestionnaire",
        "ClusterId": "rag",
        "Match": { "Path": "/api/reponses/{**reste}" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "rag-ingestions": {
        "AuthorizationPolicy": "rag-ingestion",
        "ClusterId": "rag",
        "Match": { "Path": "/api/ingestions/{**reste}" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "rag-extraits": {
        "AuthorizationPolicy": "rag-gestionnaire",
        "ClusterId": "rag",
        "Match": { "Path": "/api/extraits/{**reste}" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "rag-documents": {
        "AuthorizationPolicy": "rag-gestionnaire",
        "ClusterId": "rag",
        "Match": { "Path": "/api/documents/{**reste}" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "rag-docs": {
        "AuthorizationPolicy": "anonymous",
        "ClusterId": "rag",
        "Match": { "Path": "/rag/{**reste}" },
        "Transforms": [
          { "PathRemovePrefix": "/rag" },
          { "X-Forwarded": "Set", "Prefix": "Off" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/rag" }
        ]
      },
      "rag-sante": {
        "AuthorizationPolicy": "anonymous",
        "ClusterId": "rag",
        "Match": { "Path": "/health/rag" },
        "Transforms": [ { "PathSet": "/health" }, { "X-Forwarded": "Set" } ]
      },
      "underwriting-contrats": {
        "AuthorizationPolicy": "underwriting-gestionnaire",
        "ClusterId": "underwriting",
        "Match": { "Path": "/api/contrats/{**reste}" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "underwriting-traces": {
        "AuthorizationPolicy": "underwriting-gestionnaire",
        "ClusterId": "underwriting",
        "Match": { "Path": "/api/traces/{**reste}" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "underwriting-otlp": {
        "AuthorizationPolicy": "underwriting-telemetrie",
        "ClusterId": "underwriting",
        "Match": { "Path": "/v1/traces" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "underwriting-docs": {
        "AuthorizationPolicy": "anonymous",
        "ClusterId": "underwriting",
        "Match": { "Path": "/underwriting/{**reste}" },
        "Transforms": [
          { "PathRemovePrefix": "/underwriting" },
          { "X-Forwarded": "Set", "Prefix": "Off" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/underwriting" }
        ]
      },
      "underwriting-sante": {
        "AuthorizationPolicy": "anonymous",
        "ClusterId": "underwriting",
        "Match": { "Path": "/health/underwriting" },
        "Transforms": [ { "PathSet": "/health" }, { "X-Forwarded": "Set" } ]
      }
    },
    "Clusters": {
      "rag": {
        "Destinations": { "d1": { "Address": "http://localhost:8001" } }
      },
      "underwriting": {
        "Destinations": { "d1": { "Address": "http://localhost:8002" } }
      }
    }
  }
}
