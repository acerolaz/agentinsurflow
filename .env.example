# Copier en .env (jamais versionné) puis remplir. Clés SANS valeurs ici.
# Chaque clé est reportée À LA MAIN dans GitHub : voir docs/secrets.md (type, portée, usage YAML).

# --- Application ---------------------------------------------------------------
# local | staging | production (posé par la chaîne en Azure ; pas dans GitHub)
APP_ENV=

# --- Azure OpenAI / Foundry : sans endpoint, l'agent répond en mode dégradé ----------
# rag appelle le LLM PAR LA GATEWAY : ${GATEWAY_URL}/api/llm (compose : http://gateway:8000/api/llm), sans clé
AZURE_OPENAI_ENDPOINT=
# audience du LLM : api://<appId de agentinsurflow-llm> (jeton d'application de rag, rôle LLM ; secret :
# RAG_CLIENT_SECRET en local, identité managée fédérée en Azure) → variable GitHub du REPO
LLM_AUDIENCE=
# ID client de agentinsurflow-llm (2e audience de la gateway : jetons v2) ; affiché par make llm
LLM_API_CLIENT_ID=
# endpoint Foundry joint par la gateway (cluster llm) → variable GitHub du REPO ; make llm l'affiche
FOUNDRY_ENDPOINT=
# make llm seulement : ressource Foundry (nom, groupe de ressources)
FOUNDRY_NAME=
FOUNDRY_RESOURCE_GROUP=
# 🔒 LOCAL SEULEMENT, jamais dans GitHub : identité de la gateway en local (agentinsurflow-gateway-local, make llm) ;
#    vide = identité managée (Azure)
GATEWAY_CLIENT_ID=
GATEWAY_CLIENT_SECRET=
# surcharge locale du modèle ; la version de référence est épinglée dans llm.env (versionné)
AZURE_OPENAI_DEPLOYMENT=
# délai max d'un appel LLM en secondes (défaut 30, aligné sur la porte p95 ; pas dans GitHub)
LLM_DELAI_S=
# surcharge locale du déploiement d'embeddings (référence épinglée dans rag/llm.env)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# --- Recherche (rag) → variables GitHub du REPO --------------------------------------
# OBLIGATOIRE pour /api/extraits : cosinus minimal (0 à 1), à calibrer avec make calibrer (C1)
RAG_SEUIL=
# nombre d'extraits rendus (défaut 5, de 1 à 20)
RAG_TOP_K=

# --- Légifrance (make extraire, make ingest) : application PISTE du bac à sable -------
# 🔒 LOCAL SEULEMENT, jamais dans GitHub : la CI et Azure rejouent un instantané (data/raw/)
LEGIFRANCE_CLIENT_ID=
LEGIFRANCE_CLIENT_SECRET=
# défauts : bac à sable PISTE (sandbox-oauth / sandbox-api.piste.gouv.fr)
LEGIFRANCE_OAUTH_URL=
LEGIFRANCE_API_URL=
# jetons Entra de la CLI (sinon « az login ») : rôle Ingestion (rag), rôle Telemetrie (underwriting)
INGESTION_JETON=
TELEMETRIE_JETON=

# --- Azure : lu par make infra, puis reporté en variables GitHub ---------------------
AZURE_SUBSCRIPTION_ID=
# ex. francecentral (make infra seulement)
AZURE_LOCATION=
AZURE_RESOURCE_GROUP=
# nom globalement unique, minuscules et chiffres
ACR_NAME=
# (make infra seulement)
CONTAINERAPPS_ENV=
# → variable CONTAINER_APP_NAME de l'environnement GitHub « staging »
APP_STAGING=
# → variable CONTAINER_APP_NAME de l'environnement GitHub « production »
APP_PRODUCTION=
# Container Apps d'underwriting-admin (entrée interne 8002) → variable UW_APP_NAME de l'environnement « staging » / « production »
UW_APP_STAGING=
UW_APP_PRODUCTION=
# Container Apps du serveur MCP (entrée interne) → variable MCP_APP_NAME de l'environnement « staging » / « production »
MCP_APP_STAGING=
MCP_APP_PRODUCTION=
# Container Apps de rag (entrée interne) → variable RAG_APP_NAME de l'environnement « staging » / « production »
RAG_APP_STAGING=
RAG_APP_PRODUCTION=
# Container Apps de la base PostgreSQL annexe (entrée TCP interne) → variable PG_APP_NAME de l'environnement « staging » / « production » ; c'est aussi le PG_HOST de rag et d'underwriting-admin en Azure
PG_APP_STAGING=
PG_APP_PRODUCTION=
# affichés par make infra (identité OIDC de la CI : identifiants, pas des secrets)
AZURE_CLIENT_ID=
AZURE_TENANT_ID=

# --- Entra ID : inscriptions d'application des services (S3-20) → variables GitHub du REPO ---
# ID client de agentinsurflow-rag (audience des jetons ; client public de la page Swagger)
RAG_API_CLIENT_ID=
# audiences acceptées pour rag, lues par rag ET par la gateway (une seule liste, « a, b ») :
# <ID client>,api://<ID client> (identifierUri api://<ID client>) ; défaut du compose : api://agentinsurflow-rag
RAG_API_AUDIENCES=
# ID client de agentinsurflow-underwriting
UNDERWRITING_API_CLIENT_ID=
# audiences acceptées pour underwriting-admin (même principe)
UNDERWRITING_API_AUDIENCES=
# 🔒 LOCAL SEULEMENT, jamais dans GitHub : secret de agentinsurflow-rag pour l'On-Behalf-Of.
#    En Azure : aucune clé, identité managée fédérée (AZURE_UAMI_CLIENT_ID).
RAG_CLIENT_SECRET=
# ID client de agentinsurflow-mcp (serveur MCP : audience des jetons)
MCP_API_CLIENT_ID=
# audiences acceptées pour le serveur MCP, lues par lui ET par la gateway ; défaut du compose : api://agentinsurflow-mcp
MCP_API_AUDIENCES=
# azp (ID client) des agents inscrits par #7 : matrice d'accès du serveur MCP ; vide = agent inconnu, aucun outil
MCP_AZP_ORCHESTRATEUR=
MCP_AZP_REDACTEUR=
MCP_AZP_ACTUAIRE=
MCP_AZP_PIECES=
MCP_AZP_ANALYSTE=
# 🔒 LOCAL SEULEMENT, jamais dans GitHub : secret de agentinsurflow-mcp pour l'On-Behalf-Of.
#    En Azure : aucune clé, identité managée fédérée (AZURE_UAMI_CLIENT_ID).
MCP_CLIENT_SECRET=
# adresse par laquelle le serveur MCP joint rag et underwriting : la GATEWAY (défaut http://localhost:8000, D22)
GATEWAY_URL=
# Function de calcul (Azure : CALCUL_URL, déployée par make calcul). Le serveur MCP l'appelle PAR LA GATEWAY (/api/calcul), avec un jeton d'application (rôle Calcul du MCP).
# En local, ce jeton exige MCP_CLIENT_SECRET, MCP_API_CLIENT_ID, AZURE_TENANT_ID, CALCUL_AUDIENCE et CALCUL_API_CLIENT_ID renseignés, et make calcul passé :
# sinon evaluer_risque et calculer_prime rendent CALCUL_INDISPONIBLE.
CALCUL_URL=
CALCUL_AUDIENCE=
# GUID de l'application agentinsurflow-calcul (aud des jetons v2) : 2e audience de la gateway
CALCUL_API_CLIENT_ID=
# ID client de l'identité managée attribuée par l'utilisateur (Azure) → variable GitHub du REPO
AZURE_UAMI_CLIENT_ID=
# ID client de l'identité managée PROPRE du serveur MCP (Azure, affiché par make entra) → variable GitHub du REPO ; le serveur la lit sous le nom AZURE_UAMI_CLIENT_ID
AZURE_UAMI_MCP_CLIENT_ID=
# ID client de l'identité managée PROPRE de rag (Azure, affiché par make entra) → variable GitHub du REPO ; rag la lit sous le nom AZURE_UAMI_CLIENT_ID
AZURE_UAMI_RAG_CLIENT_ID=
# adresse par laquelle rag lit les dossiers : la GATEWAY (défaut http://localhost:8000, D22)
UNDERWRITING_URL=
# récepteur OTLP des traces (défaut http://localhost:8002/v1/traces pour rag, la gateway et, en local, le serveur MCP : export direct) ; OTEL_SDK_DISABLED=true les coupe
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Azure seulement : audience api://<appId underwriting> du jeton d'application (rôle Telemetrie) posé par le serveur MCP sur ses exports, qui passent par la gateway (/v1/traces). Vide en local (export direct, sans jeton)
TELEMETRIE_AUDIENCE=

# --- PostgreSQL annexe (make up, make test-integration, make annexe) -------------------
# 🔒 mots de passe générés (ex. openssl rand -hex 16) ; en Azure : secrets de la Container App,
#    en CI : générés à chaque run. Jamais dans GitHub.
PG_POSTGRES_PASSWORD=
PG_MIGRATEUR_PASSWORD=
PG_WRITER_PASSWORD=
PG_READER_PASSWORD=
PG_DOSSIERS_PASSWORD=
PG_TRACES_WRITER_PASSWORD=
PG_TRACES_READER_PASSWORD=
# localhost par défaut ; « postgres » dans le compose
PG_HOST=
# 5432 par défaut (port publié par le compose)
PG_PORT=
# suffixe des bases (« _test » pour les TI : vecteurs_test, dossiers_test, traces_test)
PG_SUFFIXE_BASES=

# --- underwriting-admin : base dossiers ------------------------------------------------
# oid Entra (GUID) des deux gestionnaires du seed BOLA ; vides → pas de dossier de démonstration
SEED_GESTIONNAIRE_A=
SEED_GESTIONNAIRE_B=
# true : applique les migrations de la base dossiers au démarrage (compte migrateur)
Migrations__AuDemarrage=
# CIDR acceptés sans jeton sur /v1/traces (défaut : boucle locale ; le compose ajoute son réseau)
Otlp__SourcesSansJeton=

# --- Evals et E2E (make eval, make test-e2e) : jetons sinon « az account get-access-token » ---
EVALS_JETON=
# gateway visée (défaut http://localhost:8000)
E2E_URL=
E2E_JETON_GESTIONNAIRE=
E2E_JETON_GESTIONNAIRE_UNDERWRITING=
E2E_JETON_MCP=
E2E_JETON_INGESTION=
# un contrat du gestionnaire connecté (témoin positif BOLA) ; exigé hors local → variable GitHub du REPO
E2E_CONTRAT_PROPRE=
# 1 : un manque d'environnement fait échouer au lieu de sauter (toujours en staging)
E2E_STRICT=

# --- GitHub (Makefile : proteger, rollback, preuve) -----------------------------------
# acerolaz/agentinsurflow
GITHUB_REPO=


# --- Function de calcul (make calcul) ---------------------------------------------------
CALCUL_APP_STAGING=
CALCUL_APP_PRODUCTION=
CALCUL_STORAGE=
