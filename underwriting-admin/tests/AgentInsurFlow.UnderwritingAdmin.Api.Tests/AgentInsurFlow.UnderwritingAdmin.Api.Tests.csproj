<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- Les noms de tests en français, avec des soulignés, sont voulus -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <!-- transitifs vulnérables (9.0.0) via Identity.Web : relevés -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" Version="1.20.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentInsurFlow.UnderwritingAdmin.Api\AgentInsurFlow.UnderwritingAdmin.Api.csproj" />
  </ItemGroup>

</Project>
