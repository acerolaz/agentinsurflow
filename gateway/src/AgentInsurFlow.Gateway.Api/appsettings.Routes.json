{
  "ReverseProxy": {
    "Routes": {
      "rag-api": {
        "ClusterId": "rag",
        "Match": { "Path": "/api/{**reste}" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "rag-ingestion": {
        "ClusterId": "rag",
        "Match": { "Path": "/v1/ingestion/{**reste}" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "rag-interne": {
        "ClusterId": "rag",
        "Match": { "Path": "/internal/rag/{**reste}" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "rag-docs": {
        "ClusterId": "rag",
        "Match": { "Path": "/rag/{**reste}" },
        "Transforms": [ { "PathRemovePrefix": "/rag" }, { "X-Forwarded": "Set" } ]
      },
      "rag-sante": {
        "ClusterId": "rag",
        "Match": { "Path": "/health/rag" },
        "Transforms": [ { "PathSet": "/health" }, { "X-Forwarded": "Set" } ]
      },
      "underwriting-sql": {
        "ClusterId": "underwriting",
        "Match": { "Path": "/internal/sql/{**reste}" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "underwriting-traces-lecture": {
        "ClusterId": "underwriting",
        "Match": { "Path": "/internal/traces/{**reste}" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "underwriting-traces-otlp": {
        "ClusterId": "underwriting",
        "Match": { "Path": "/v1/traces" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "underwriting-docs": {
        "ClusterId": "underwriting",
        "Match": { "Path": "/underwriting/{**reste}" },
        "Transforms": [ { "PathRemovePrefix": "/underwriting" }, { "X-Forwarded": "Set" } ]
      },
      "underwriting-sante": {
        "ClusterId": "underwriting",
        "Match": { "Path": "/health/underwriting" },
        "Transforms": [ { "PathSet": "/health" }, { "X-Forwarded": "Set" } ]
      }
    },
    "Clusters": {
      "rag": {
        "Destinations": { "d1": { "Address": "http://localhost:8001" } }
      },
      "underwriting": {
        "Destinations": { "d1": { "Address": "http://localhost:8002" } }
      }
    }
  }
}
