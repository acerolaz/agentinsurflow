{
  "ReverseProxy": {
    "Routes": {
      "rag-reponses": {
        "AuthorizationPolicy": "rag-gestionnaire",
        "RateLimiterPolicy": "reponses",
        "ClusterId": "rag",
        "Match": { "Path": "/api/reponses/{**reste}" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "rag-ingestions": {
        "AuthorizationPolicy": "rag-ingestion",
        "ClusterId": "rag",
        "Match": { "Path": "/api/ingestions/{**reste}" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "rag-extraits": {
        "AuthorizationPolicy": "rag-gestionnaire",
        "ClusterId": "rag",
        "Match": { "Path": "/api/extraits/{**reste}" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "rag-documents": {
        "AuthorizationPolicy": "rag-gestionnaire",
        "ClusterId": "rag",
        "Match": { "Path": "/api/documents/{**reste}" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "rag-docs": {
        "AuthorizationPolicy": "anonymous",
        "ClusterId": "rag",
        "Match": { "Path": "/rag/openapi.json", "Methods": [ "GET" ] },
        "Transforms": [
          { "PathRemovePrefix": "/rag" },
          { "X-Forwarded": "Set", "Prefix": "Off" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/rag" }
        ]
      },
      "rag-sante": {
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "Disable",
        "ClusterId": "rag",
        "Match": { "Path": "/health/rag" },
        "Transforms": [ { "PathSet": "/health" }, { "X-Forwarded": "Set" } ]
      },
      "underwriting-etat": {
        "AuthorizationPolicy": "underwriting-etat-mcp",
        "ClusterId": "underwriting",
        "Match": { "Path": "/api/contrats/{numero_contrat}/etat", "Methods": [ "PUT" ] },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "underwriting-points-de-reprise": {
        "AuthorizationPolicy": "underwriting-points-de-reprise",
        "RateLimiterPolicy": "Disable",
        "ClusterId": "underwriting",
        "Match": { "Path": "/api/points-de-reprise/{**reste}" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "underwriting-contrat-genere": {
        "AuthorizationPolicy": "underwriting-gestionnaire",
        "ClusterId": "underwriting",
        "Match": { "Path": "/v1/souscriptions/{numero_contrat}/contrat", "Methods": [ "GET" ] },
        "Transforms": [ { "PathPattern": "/api/contrats/{numero_contrat}/contrat" }, { "X-Forwarded": "Set" } ]
      },
      "underwriting-contrats": {
        "AuthorizationPolicy": "underwriting-gestionnaire",
        "ClusterId": "underwriting",
        "Match": { "Path": "/api/contrats/{**reste}" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "underwriting-traces": {
        "AuthorizationPolicy": "underwriting-gestionnaire",
        "ClusterId": "underwriting",
        "Match": { "Path": "/api/traces/{**reste}" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "underwriting-otlp": {
        "AuthorizationPolicy": "underwriting-telemetrie",
        "ClusterId": "underwriting",
        "Match": { "Path": "/v1/traces" },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "underwriting-docs": {
        "AuthorizationPolicy": "anonymous",
        "ClusterId": "underwriting",
        "Match": { "Path": "/underwriting/openapi/v1.json", "Methods": [ "GET" ] },
        "Transforms": [
          { "PathRemovePrefix": "/underwriting" },
          { "X-Forwarded": "Set", "Prefix": "Off" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/underwriting" }
        ]
      },
      "mcp": {
        "AuthorizationPolicy": "mcp-gestionnaire",
        "RateLimiterPolicy": "mcp",
        "ClusterId": "mcp",
        "Match": { "Path": "/mcp", "Methods": [ "POST", "GET" ] },
        "Transforms": [ { "X-Forwarded": "Set" } ]
      },
      "mcp-sante": {
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "Disable",
        "ClusterId": "mcp",
        "Match": { "Path": "/health/mcp" },
        "Transforms": [ { "PathSet": "/health" }, { "X-Forwarded": "Set" } ]
      },
      "cluster-evaluation": {
        "AuthorizationPolicy": "cluster-gestionnaire",
        "RateLimiterPolicy": "cluster",
        "ClusterId": "cluster",
        "Match": { "Path": "/v1/souscriptions/{numero_contrat}/evaluation", "Methods": [ "POST" ] },
        "Transforms": [ { "PathPattern": "/evaluations/{numero_contrat}" }, { "X-Forwarded": "Set" } ]
      },
      "cluster-revue": {
        "AuthorizationPolicy": "cluster-gestionnaire",
        "RateLimiterPolicy": "cluster",
        "ClusterId": "cluster",
        "Match": { "Path": "/v1/souscriptions/{numero_contrat}/revue", "Methods": [ "POST" ] },
        "Transforms": [ { "PathPattern": "/evaluations/{numero_contrat}/revue" }, { "X-Forwarded": "Set" } ]
      },
      "cluster-pause": {
        "AuthorizationPolicy": "cluster-gestionnaire",
        "RateLimiterPolicy": "cluster",
        "ClusterId": "cluster",
        "Match": { "Path": "/v1/souscriptions/{numero_contrat}/pause", "Methods": [ "POST" ] },
        "Transforms": [ { "PathPattern": "/evaluations/{numero_contrat}/pause" }, { "X-Forwarded": "Set" } ]
      },
      "cluster-docs": {
        "AuthorizationPolicy": "anonymous",
        "ClusterId": "cluster",
        "Match": { "Path": "/cluster/openapi.json", "Methods": [ "GET" ] },
        "Transforms": [
          { "PathRemovePrefix": "/cluster" },
          { "X-Forwarded": "Set", "Prefix": "Off" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/cluster" }
        ]
      },
      "cluster-sante": {
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "Disable",
        "ClusterId": "cluster",
        "Match": { "Path": "/health/cluster" },
        "Transforms": [ { "PathSet": "/health" }, { "X-Forwarded": "Set" } ]
      },
      "calcul": {
        "AuthorizationPolicy": "calcul-mcp",
        "RateLimiterPolicy": "calcul",
        "ClusterId": "calcul",
        "Match": { "Path": "/api/calcul/{**reste}", "Methods": [ "POST" ] },
        "Transforms": [ { "PathPattern": "/api/{**reste}" }, { "X-Forwarded": "Set" } ]
      },
      "llm": {
        "AuthorizationPolicy": "llm-appelant",
        "RateLimiterPolicy": "llm",
        "ClusterId": "llm",
        "Match": { "Path": "/api/llm/{**reste}", "Methods": [ "POST" ] },
        "Transforms": [ { "PathPattern": "/openai/{**reste}" }, { "X-Forwarded": "Set" } ]
      },
      "calcul-sante": {
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "Disable",
        "ClusterId": "calcul",
        "Match": { "Path": "/health/calcul" },
        "Transforms": [ { "PathSet": "/api/sante" }, { "X-Forwarded": "Set" } ]
      },
      "underwriting-sante": {
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "Disable",
        "ClusterId": "underwriting",
        "Match": { "Path": "/health/underwriting" },
        "Transforms": [ { "PathSet": "/health" }, { "X-Forwarded": "Set" } ]
      }
    },
    "Clusters": {
      "rag": {
        "Destinations": { "d1": { "Address": "http://localhost:8001" } }
      },
      "underwriting": {
        "Destinations": { "d1": { "Address": "http://localhost:8002" } }
      },
      "mcp": {
        "HttpRequest": { "ActivityTimeout": "00:05:00" },
        "Destinations": { "d1": { "Address": "http://localhost:8003" } }
      },
      "cluster": {
        "Destinations": { "d1": { "Address": "http://localhost:8004" } }
      },
      "calcul": {
        "Destinations": { "d1": { "Address": "http://localhost:7071" } }
      },
      "llm": {
        "HttpRequest": { "ActivityTimeout": "00:05:00" },
        "Destinations": { "d1": { "Address": "http://localhost:8010" } }
      }
    }
  }
}
